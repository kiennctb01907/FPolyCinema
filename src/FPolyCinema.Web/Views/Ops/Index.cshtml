@model OpsDashboardVm
@* Dashboard vận hành của quản lý ca /ops (UI A7, SPEC 3.2-07, 3.3-21, 3.8-12): yêu cầu phê duyệt đang chờ, suất trễ báo đỏ, sĩ số trực tiếp,
   phòng đang dọn, nhắc giải phóng ghế nội bộ, phiếu hủy hàng chờ duyệt. Tự tải lại khi có SHOWTIME_OPS_CHANGED, APPROVAL_REQUESTED, APPROVAL_DECIDED. *@
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Vận hành ca";
    ViewData["Crumbs"] = new List<Crumb> { new("Tổng quan"), new("Vận hành ca") };
    var header = new PageHeaderVm
    {
        Title = "Vận hành ca",
        Description = $"{Model.ScopeName} · cập nhật trực tiếp theo đồng hồ suất chiếu, máy soát vé và yêu cầu từ quầy.",
        Crumbs = new() { new("Tổng quan"), new("Vận hành ca") },
        Actions = @<text>
            <a class="btn btn-secondary" href="/ops/wastage?status=PENDING"><i class="bi bi-trash3" aria-hidden="true"></i>Phiếu hủy hàng</a>
            <a class="btn btn-danger" href="/ops/incident"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>Hủy suất do sự cố</a>
        </text>,
    };
}
<partial name="_PageHeader" model="header" />
<div data-region data-url="/ops" data-ops data-cinema-ids="@string.Join(",", Model.CinemaIds)" data-auditorium-ids="@string.Join(",", Model.AuditoriumIds)">
    <div data-region-content>
        <partial name="_OpsBody" model="Model" />
    </div>
</div>
@section Scripts {
    <script src="~/js/pages/ops.js" asp-append-version="true"></script>
}
