@model OpsDashboardVm
@* Khối vận hành ở dashboard /admin (UI A1-05, A7-03): yêu cầu phê duyệt đang chờ, sĩ số trực tiếp các suất đang chạy, suất trễ báo đỏ. Tải lại bằng /ops/live. *@
@if (Model.Board.Late.Count > 0)
{
    <div class="ops-late mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
        @Model.Board.Late.Count suất đã quá giờ chiếu nhưng phòng chưa sẵn sàng: @string.Join("; ", Model.Board.Late.Select(s => $"{s.AuditoriumName} {Fmt.Time(s.StartTime)}")).
        <a href="/ops" class="fw-semibold">Xem ở Vận hành ca</a>
    </div>
}
<div class="row g-4">
    <div class="col-12 col-xl-5">
        <section class="card-ui card-ui-body h-100" aria-labelledby="dash-approvals">
            <h2 class="h6" id="dash-approvals">Yêu cầu phê duyệt đang chờ @if (Model.Approvals.Count > 0) { <span class="count-pill" aria-hidden="true">@Model.Approvals.Count</span> }</h2>
            <partial name="_ApprovalList" model="Model.Approvals" />
        </section>
    </div>
    <div class="col-12 col-xl-7">
        <section class="card-ui card-ui-body h-100" aria-labelledby="dash-occupancy">
            <h2 class="h6" id="dash-occupancy">Sĩ số trực tiếp các suất đang chạy</h2>
            <partial name="_LiveOccupancy" model="Model.Board.Running" />
        </section>
    </div>
</div>
