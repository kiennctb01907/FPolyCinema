@model HolidaysVm
@* Ngày lễ (SPEC 3.4): ngày vận hành có trong danh sách tính giá DAY_TYPE = HOLIDAY. Thêm ngày lễ, xóa ngày lễ (hỏi trước khi xóa). *@
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ngày lễ";
    ViewData["Crumbs"] = new List<Crumb> { new("Rạp và phòng"), new("Bảng giá", "/admin/pricing"), new("Ngày lễ") };
}
<partial name="_PageHeader" model="@(new PageHeaderVm { Title = "Ngày lễ", Description = "Ngày có trong danh sách được tính giá theo dòng Ngày lễ của bảng giá, thay cho ngày thường, cuối tuần hay thứ Ba vui vẻ.", Crumbs = new() { new("Bảng giá", "/admin/pricing"), new("Ngày lễ") } })" />
<partial name="_Tabs" model="@("holidays")" />
<div class="row g-4">
    <div class="col-12 col-lg-8">
        <form class="filter-bar" method="get" data-filter aria-label="Chọn năm">
            <div class="filter-item">
                <label class="form-label" for="f-year">Năm</label>
                <select class="form-select" id="f-year" name="year">
                    @foreach (var y in Model.Years) { <option value="@y" selected="@(y == Model.Year)">@y</option> }
                </select>
            </div>
        </form>
        @if (Model.Holidays.Count == 0)
        {
            <div class="card-ui"><partial name="_EmptyState" model="@(new EmptyStateVm { Icon = "bi-calendar-heart", Title = $"Chưa có ngày lễ năm {Model.Year}", Text = "Thêm ngày lễ ở khung bên cạnh để giá vé ngày đó tính theo dòng Ngày lễ." })" /></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table" id="holiday-table">
                    <caption class="visually-hidden">Ngày lễ năm @Model.Year</caption>
                    <thead><tr><th scope="col">Ngày</th><th scope="col">Tên ngày lễ</th><th scope="col" class="col-actions">Thao tác</th></tr></thead>
                    <tbody>
                        @foreach (var h in Model.Holidays)
                        {
                            <tr>
                                <td class="cell-title num">@Fmt.WeekdayDate(h.HolidayDate)/@h.HolidayDate.Year</td>
                                <td data-label="Tên ngày lễ">@h.Name</td>
                                <td class="col-actions">
                                    <button type="button" class="btn btn-ghost btn-icon btn-sm" aria-label="Xóa ngày lễ @Fmt.Date(h.HolidayDate)" data-bs-toggle="tooltip" title="Xóa"
                                            data-holiday-delete="/admin/pricing/holidays/@h.HolidayDate.ToString("yyyy-MM-dd")/delete" data-name="@h.Name (@Fmt.Date(h.HolidayDate))">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-12 col-lg-4">
        <form asp-antiforgery="true" method="post" action="/admin/pricing/holidays" class="card-ui card-ui-body" novalidate>
            <h2 class="card-ui-title">Thêm ngày lễ</h2>
            <partial name="~/Views/Login/_FormErrors.cshtml" />
            <div class="mb-3">
                <label class="form-label" for="HolidayDate">Ngày <span class="req" aria-hidden="true">*</span></label>
                <div class="date-field"><input type="date" class="form-control" id="HolidayDate" name="holidayDate" value="@Model.NewDate?.ToString("yyyy-MM-dd")" /><span class="date-display" aria-hidden="true"></span></div>
                @Html.ValidationMessage("HolidayDate")
            </div>
            <div class="mb-3">
                <label class="form-label" for="Name">Tên ngày lễ <span class="req" aria-hidden="true">*</span></label>
                <input class="form-control" id="Name" name="name" value="@Model.NewName" maxlength="150" placeholder="Ví dụ: Quốc khánh" />
                @Html.ValidationMessage("Name")
            </div>
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg" aria-hidden="true"></i>Thêm ngày lễ</button>
        </form>
    </div>
</div>
@section Scripts {
    <script src="~/js/pages/pricing.js" asp-append-version="true"></script>
}
