@model ErrorVm
@* Trang lỗi và trang từ chối truy cập (UI D3): layout của khu vực đang đứng, icon 48px, một câu giải thích tiếng Việt,
   nút quay về trang chính của vai trò. Không hiện stack trace; mã hỗ trợ ghi nhỏ ở cuối. *@
@{
    Layout = ViewData["Layout"] as string ?? "_LayoutCustomer";
    ViewData["Title"] = Model.Title;
    var inPos = Layout == "_LayoutPos";
}
@if (inPos)
{
    @:<div class="pos-scroll">
}
<div class="empty-state @(Model.StatusCode >= 500 ? "tone-error" : null)">
    <div class="empty-icon"><i class="bi @Model.Icon" aria-hidden="true"></i></div>
    <h1 class="h3">@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="btn btn-primary" href="@Model.HomeUrl"><i class="bi bi-house" aria-hidden="true"></i>@Model.HomeLabel</a>
    @if (!string.IsNullOrEmpty(Model.SupportCode))
    {
        <p class="small text-muted mt-4 mb-0">Mã hỗ trợ: @Model.SupportCode</p>
    }
</div>
@if (inPos)
{
    @:</div>
}
