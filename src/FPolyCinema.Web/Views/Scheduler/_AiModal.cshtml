@model SchedulerVm
@using System.Globalization
@* Hộp "AI tự động xếp lịch" (UI A5-03, SPEC 4.3-02, UC35): rạp đang chọn, ngày bắt đầu và số ngày (1–7), danh sách phim (tự lọc phim có giấy phép,
   khác C, KDM còn hiệu lực; phim không xếp được bị khóa kèm lý do, kèm AiDemandScore lần chạy trước), danh sách phòng.
   Bấm "Xếp lịch" gọi POST /scheduler/ai/generate; bản nháp hiện trên Gantt để Manager xem, kéo chỉnh, rồi bấm "Áp dụng". *@
@{
    var from = Model.Date < Model.Today ? Model.Today : Model.Date;
    var ai = Model.Ai7.Ai;
}
<div class="modal fade" id="ai-scheduler" tabindex="-1" aria-labelledby="ai-scheduler-title" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form class="modal-content" data-ai-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title" id="ai-scheduler-title"><i class="bi bi-stars text-primary" aria-hidden="true"></i> AI tự động xếp lịch</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">AI tính lại điểm nhu cầu (AiDemandScore) của từng phim, chia số suất theo điểm, ưu tiên phim Việt trong khung 18:00–22:00 và
                    không động vào các suất đã có. Kết quả là bản nháp; chỉ khi bạn bấm "Áp dụng" mới lưu.</p>
                <input type="hidden" name="cinemaId" value="@Model.CinemaId" />
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="ai-from">Từ ngày</label>
                        <div class="date-field"><input type="date" class="form-control" id="ai-from" name="fromDate" value="@from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" min="@Model.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required /><span class="date-display" aria-hidden="true"></span></div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="ai-days">Số ngày</label>
                        <select class="form-select" id="ai-days" name="days">
                            @for (int i = 1; i <= AiSchedulerService.MaxDays; i++) { <option value="@i" selected="@(i == 1)">@i ngày</option> }
                        </select>
                    </div>
                </div>
                <fieldset class="mb-3">
                    <legend class="form-label">Phim (<span data-ai-eligible>@ai.Movies.Count(m => m.Eligible)</span> phim xếp được trong khoảng ngày đã chọn)</legend>
                    <div class="ai-movie-list" data-ai-movies aria-live="polite">
                        @foreach (var o in ai.Movies)
                        {
                            var id = $"ai-m-{o.Movie.Id}";
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="movieIds" value="@o.Movie.Id" id="@id" checked="@o.Eligible" disabled="@(!o.Eligible)" />
                                <label class="form-check-label" for="@id">
                                    <partial name="_AgeBadge" model="@(new AgeBadgeVm(o.Movie.AgeRating))" />
                                    @o.Movie.Title @if (o.Movie.IsVietnameseFilm) { <span class="outline-badge">Phim Việt</span> }
                                    <span class="meta d-block">@(o.Eligible ? (o.Movie.AiDemandScore is decimal sc ? $"AiDemandScore lần trước {Fmt.Decimal(sc)}/10" : "Chưa có AiDemandScore") : o.Reason)</span>
                                </label>
                            </div>
                        }
                    </div>
                    <div class="field-validation-valid" data-valmsg-for="movieIds"></div>
                </fieldset>
                <fieldset>
                    <legend class="form-label">Phòng chiếu</legend>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var a in ai.Rooms)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="auditoriumIds" value="@a.Id" id="ai-a-@a.Id" checked />
                                <label class="form-check-label" for="ai-a-@a.Id">@a.Name@(a.Name.Contains(a.Format) ? null : " · " + a.Format)</label>
                            </div>
                        }
                    </div>
                    <div class="field-validation-valid" data-valmsg-for="auditoriumIds"></div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary" data-ai-submit><i class="bi bi-stars" aria-hidden="true"></i>Xếp lịch</button>
            </div>
        </form>
    </div>
</div>
