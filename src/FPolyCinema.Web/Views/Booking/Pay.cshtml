@model PayVm
@* Màn hình QR (UI C3-13): QR lớn ở giữa, đồng hồ đếm ngược theo HoldExpiresAt, trạng thái cập nhật trực tiếp qua kênh 3 (PAYMENT_STATUS_CHANGED):
   "Đang chờ thanh toán…" → "Thanh toán thành công" kèm dấu ✓, rồi tự chuyển sang vé điện tử (SPEC 3.7-08). *@
@{
    ViewData["Title"] = "Thanh toán " + Model.Bill.Code;
    var steps = new StepperVm { Steps = new() { "Chọn suất", "Chọn ghế", "Bắp nước và ưu đãi", "Thanh toán" }, Current = 4 };
    var waiting = Model.Bill.Status == BillStatus.Waiting;
}
<div class="pay-screen" data-pay-screen data-bill-id="@Model.Bill.Id" data-code="@Model.Bill.Code" data-status="@Model.Bill.Status" data-ticket-url="/tickets/@Model.Bill.Code">
    <div class="booking-stepper"><partial name="_Stepper" model="steps" /></div>
    <section class="card-ui card-ui-body pay-card" aria-labelledby="pay-title">
        <h1 id="pay-title" class="h4 text-center mb-1">Quét mã để thanh toán</h1>
        @if (Model.Info != null)
        {
            <p class="text-center text-muted mb-3">@Model.Info.Movie.Title <partial name="_AgeBadge" model="@(new AgeBadgeVm(Model.Info.Movie.AgeRating))" /> · @Fmt.WeekdayDate(Model.Info.Showtime.StartTime) @Fmt.Time(Model.Info.Showtime.StartTime) · Đơn @Model.Bill.Code</p>
        }
        <p class="pay-amount money text-center">@Fmt.Money(Model.Bill.Total)</p>
        <div class="d-flex justify-content-center">
            <partial name="_QrBlock" model="@(new QrBlockVm(Model.QrDataUri, "VietQR mô phỏng", null, true))" />
        </div>
        @if (Model.ExpiresAt is DateTime exp)
        {
            ViewData["RestartUrl"] = Model.Info != null ? $"/booking/{Model.Info.Showtime.Id}" : "/";
            <div class="d-flex justify-content-center my-3"><partial name="_HoldTimer" model="exp" /></div>
        }
        <div class="pay-status" data-pay-status role="status" aria-live="polite">
            @if (waiting)
            {
                <span class="pay-status-icon is-waiting" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                <span data-pay-status-text>Đang chờ thanh toán…</span>
            }
            else
            {
                <span class="pay-status-icon is-failed" aria-hidden="true"><i class="bi bi-x-lg"></i></span>
                <span data-pay-status-text>Đơn này không còn chờ thanh toán (@StatusDisplay.Of(StatusDisplay.CancelReasons, Model.Bill.CancelReason).Label).</span>
            }
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
            @if (waiting)
            {
                <a class="btn btn-secondary" href="@Model.SimUrl" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>Mở trang thanh toán mô phỏng</a>
            }
            @if (Model.Info != null)
            {
                <a class="btn btn-ghost" href="/booking/@Model.Info.Showtime.Id"><i class="bi bi-arrow-left" aria-hidden="true"></i>Về đơn đặt vé</a>
            }
        </div>
        <p class="small text-muted text-center mt-3 mb-0">Đây là cổng thanh toán mô phỏng của đồ án: quét mã hoặc mở trang mô phỏng rồi bấm "Thanh toán thành công".</p>
    </section>
</div>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/realtime.js" asp-append-version="true"></script>
    <script src="~/js/pages/pay.js" asp-append-version="true"></script>
}
