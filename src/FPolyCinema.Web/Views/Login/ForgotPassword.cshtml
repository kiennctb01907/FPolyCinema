@inject Microsoft.Extensions.Options.IOptions<AuthOptions> AuthOpts
@* C6. Quên mật khẩu 2 bước trên cùng thẻ form (UC02): bước 1 nhập email; bước 2 nhập mã OTP 6 số (6 ô, tự nhảy ô, dán được cả chuỗi),
   đếm ngược 5 phút, nút "Gửi lại mã" sau 60 giây. Xong thì báo "Mật khẩu mới đã được gửi tới email của bạn" và về trang đăng nhập.
   Lời nhắn chung cho email không tồn tại để không lộ tài khoản. *@
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["Chrome"] = "auth";
    var len = AuthOpts.Value.OtpLength;
}
<div class="auth-shell">
    <partial name="_AuthArt" />
    <div class="auth-panel">
        <div class="auth-form" id="forgot" data-otp-length="@len">
            <partial name="_Logo" model="@("/")" />
            <h1>Quên mật khẩu</h1>

            <section data-step="1" aria-labelledby="step1-title">
                <h2 class="visually-hidden" id="step1-title">Bước 1: nhập email</h2>
                <p class="auth-sub">Bước 1/2 · Nhập email đã đăng ký. Chúng tôi gửi mã xác nhận 6 số tới email này.</p>
                <form id="forgot-email" novalidate>
                    <div class="mb-4">
                        <label for="fp-email" class="form-label">Email <span class="req" aria-hidden="true">*</span></label>
                        <input id="fp-email" name="email" type="email" class="form-control" autocomplete="email" placeholder="ten@gmail.com" required autofocus />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send" aria-hidden="true"></i>Gửi mã xác nhận</button>
                </form>
            </section>

            <section data-step="2" hidden aria-labelledby="step2-title">
                <h2 class="visually-hidden" id="step2-title">Bước 2: nhập mã xác nhận</h2>
                <div class="alert-ui tone-info" role="status"><i class="bi bi-envelope-check" aria-hidden="true"></i><div data-sent-message></div></div>
                <p class="auth-sub mb-3">Bước 2/2 · Nhập mã 6 số gửi tới <strong data-email></strong>. Mã còn hiệu lực <time class="num fw-500" data-otp-countdown>05:00</time>.</p>
                <form id="forgot-otp" novalidate>
                    <input type="hidden" id="fp-otp" name="otp" />
                    <fieldset class="mb-3">
                        <legend class="form-label">Mã xác nhận <span class="req" aria-hidden="true">*</span></legend>
                        <div class="otp-inputs" data-otp="fp-otp">
                            @for (int i = 0; i < len; i++)
                            {
                                <input class="form-control" data-otp-cell inputmode="numeric" autocomplete="@(i == 0 ? "one-time-code" : "off")" maxlength="@(i == 0 ? len : 1)" aria-label="Chữ số thứ @(i + 1)" />
                            }
                        </div>
                        <div class="field-error" data-otp-error hidden></div>
                    </fieldset>
                    <button type="submit" class="btn btn-primary mb-3"><i class="bi bi-shield-check" aria-hidden="true"></i>Xác nhận và nhận mật khẩu mới</button>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <button type="button" class="btn btn-ghost btn-sm" data-back><i class="bi bi-arrow-left" aria-hidden="true"></i>Đổi email</button>
                        <span tabindex="0" data-resend-wrap data-bs-toggle="tooltip" title="Bạn chờ hết 60 giây rồi mới gửi lại được mã.">
                            <button type="button" class="btn btn-secondary btn-sm" data-resend disabled><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Gửi lại mã <span class="num" data-resend-count></span></button>
                        </span>
                    </div>
                </form>
            </section>

            <section data-step="3" hidden>
                <div class="empty-state p-0 text-start align-items-start">
                    <div class="empty-icon"><i class="bi bi-envelope-paper-heart" aria-hidden="true"></i></div>
                    <h2 class="h4">Mật khẩu mới đã được gửi tới email của bạn</h2>
                    <p class="text-muted">Bạn dùng mật khẩu này để đăng nhập, sau đó đặt mật khẩu của riêng mình. Đang chuyển về trang đăng nhập…</p>
                    <a class="btn btn-primary" href="/Login/Login">Về trang đăng nhập</a>
                </div>
            </section>

            <p class="auth-alt">Nhớ ra mật khẩu? <a href="/Login/Login">Đăng nhập</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/pages/forgot-password.js" asp-append-version="true"></script>
}
