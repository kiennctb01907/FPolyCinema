@model ChangePasswordVm
@* Đổi mật khẩu. Khi MustChangePassword = 1 (đăng nhập bằng mật khẩu được cấp): trang đổi mật khẩu bắt buộc,
   không có menu, chỉ có form và nút Đăng xuất (UI C6-03). Khách vào từ menu tài khoản thì dùng layout web khách. *@
@{
    ViewData["Title"] = Model.Forced ? "Đặt mật khẩu mới" : "Đổi mật khẩu";
}
<div class="card-ui card-ui-body auth-form">
    <h1>@ViewData["Title"]</h1>
    @if (Model.Forced)
    {
        <div class="alert-ui tone-warning" role="alert">
            <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
            <div>Bạn đang dùng mật khẩu được cấp. Đặt mật khẩu mới để tiếp tục.</div>
        </div>
    }
    else
    {
        <p class="auth-sub">Đổi xong, các phiên đăng nhập khác của bạn sẽ được đăng xuất.</p>
    }
    <partial name="_FormErrors" />
    <form asp-antiforgery="true" method="post" action="/Login/ChangePassword" novalidate>
        <partial name="_ChangePasswordFields" model="Model" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle" aria-hidden="true"></i>Lưu mật khẩu mới</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
