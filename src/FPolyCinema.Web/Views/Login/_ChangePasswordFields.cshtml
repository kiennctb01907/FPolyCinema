@model ChangePasswordVm
@* Các ô đổi mật khẩu: mật khẩu hiện tại, mật khẩu mới, nhập lại; thước đo độ mạnh và nút hiện hoặc ẩn (UI A9-03, C6-03). *@
@{
    var p = ViewData["FieldPrefix"] as string ?? string.Empty;
    string N(string n) => p + n;
    string Id(string n) => (p + n).Replace('.', '_');
}
<div class="mb-3">
    <label class="form-label" for="@Id("CurrentPassword")">@(Model.Forced ? "Mật khẩu được cấp" : "Mật khẩu hiện tại") <span class="req" aria-hidden="true">*</span></label>
    <div class="input-password">
        <input type="password" class="form-control" id="@Id("CurrentPassword")" name="@N("CurrentPassword")" autocomplete="current-password" required
               data-val="true" data-val-required="Bạn chưa nhập mật khẩu hiện tại." />
        <button type="button" class="btn-toggle-pw" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="@Id("CurrentPassword")"><i class="bi bi-eye" aria-hidden="true"></i></button>
    </div>
    @Html.ValidationMessage(N("CurrentPassword"))
</div>
<div class="mb-3">
    <label class="form-label" for="@Id("NewPassword")">Mật khẩu mới <span class="req" aria-hidden="true">*</span></label>
    <div class="input-password">
        <input type="password" class="form-control" id="@Id("NewPassword")" name="@N("NewPassword")" autocomplete="new-password" required data-pw-meter="@Id("pw-meter")"
               data-val="true" data-val-required="Bạn chưa nhập mật khẩu mới." data-val-length="Mật khẩu cần ít nhất 8 ký tự." data-val-length-min="8" data-val-length-max="100" />
        <button type="button" class="btn-toggle-pw" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="@Id("NewPassword")"><i class="bi bi-eye" aria-hidden="true"></i></button>
    </div>
    <div class="pw-meter" id="@Id("pw-meter")" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="pw-meter-label" id="@Id("pw-meter")-label" aria-live="polite">Ít nhất 8 ký tự, có cả chữ và số.</div>
    @Html.ValidationMessage(N("NewPassword"))
</div>
<div class="mb-4">
    <label class="form-label" for="@Id("ConfirmPassword")">Nhập lại mật khẩu mới <span class="req" aria-hidden="true">*</span></label>
    <div class="input-password">
        <input type="password" class="form-control" id="@Id("ConfirmPassword")" name="@N("ConfirmPassword")" autocomplete="new-password" required
               data-val="true" data-val-required="Bạn chưa nhập lại mật khẩu mới." data-val-equalto="Mật khẩu nhập lại chưa khớp." data-val-equalto-other="*.NewPassword" />
        <button type="button" class="btn-toggle-pw" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="@Id("ConfirmPassword")"><i class="bi bi-eye" aria-hidden="true"></i></button>
    </div>
    @Html.ValidationMessage(N("ConfirmPassword"))
</div>
