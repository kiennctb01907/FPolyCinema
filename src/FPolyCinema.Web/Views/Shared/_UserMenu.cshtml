@* Menu người dùng (topbar quản trị, POS và header khách) *@
@{
    var u = Shell.User;
}
@if (u != null)
{
    <div class="dropdown">
        <button type="button" class="user-chip" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Tài khoản của @u.Name">
            <span class="avatar" aria-hidden="true">@u.Initials</span>
            <span class="user-meta">
                <span class="user-name">@u.Name</span>
                <span class="user-role">@u.RoleLabel</span>
            </span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><h2 class="dropdown-header">@u.Email</h2></li>
            @if (Shell.IsStaff)
            {
                <li><a class="dropdown-item" href="/me"><i class="bi bi-person-circle" aria-hidden="true"></i>Trang cá nhân</a></li>
                @if (Shell.HomePath != "/me")
                {
                    <li><a class="dropdown-item" href="@Shell.HomePath"><i class="bi bi-house" aria-hidden="true"></i>Trang chính của tôi</a></li>
                }
            }
            else
            {
                <li><a class="dropdown-item" href="/Login/Profile"><i class="bi bi-person-circle" aria-hidden="true"></i>Thông tin tài khoản</a></li>
                <li><a class="dropdown-item" href="/Login/ChangePassword"><i class="bi bi-key" aria-hidden="true"></i>Đổi mật khẩu</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-antiforgery="true" method="post" action="/Login/Logout">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Đăng xuất</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="btn btn-ghost" href="/Login/Login?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Đăng nhập</a>
}
