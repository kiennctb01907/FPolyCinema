@* Thanh đổi vai trò (chỉ khi Demo:EnableTools, UI mục 4, SPEC 5): viên thuốc nổi góc trái dưới, thu gọn được,
   hiện vai trò hiện tại, 5 nút đổi sang tài khoản mẫu bằng một lần bấm và nút mở trung tâm demo /demo/multi-screen (UI U4-15, SPEC S5-06). *@
@if (Shell.DemoEnabled)
{
    var current = Shell.DemoSlug;
    var user = Shell.User;
    var currentLabel = user == null ? "Chưa đăng nhập" : (FPolyCinema.Web.Services.DemoAccounts.Find(current)?.Label ?? user.RoleLabel);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var onHub = Context.Request.Path.StartsWithSegments("/demo/multi-screen");
    <div class="demo-bar" role="region" aria-label="Thanh đổi vai trò dùng để trình diễn">
        <button type="button" class="demo-toggle" data-demo-toggle aria-expanded="true" aria-controls="demo-roles" title="Thu gọn hoặc mở thanh đổi vai trò">
            <i class="bi bi-person-badge" aria-hidden="true"></i><span>Đang là: @currentLabel</span>
        </button>
        <nav class="demo-roles" id="demo-roles" aria-label="Đổi vai trò">
            @foreach (var a in FPolyCinema.Web.Services.DemoAccounts.All)
            {
                <a href="/demo/switch-role?role=@a.Role&amp;returnUrl=@Uri.EscapeDataString(returnUrl)" class="@(a.Slug == current ? "is-current" : null)" aria-current="@(a.Slug == current ? "true" : null)">@a.Label</a>
            }
            @* Nút chỉ có icon (nhãn đọc màn hình và tooltip) để thanh demo không dài thêm, không che nút chính của trang (UI U4-16) *@
            <a href="/demo/multi-screen" class="demo-hub-link @(onHub ? "is-current" : null)" aria-current="@(onHub ? "page" : null)" title="Trung tâm demo nhiều màn hình" data-bs-toggle="tooltip"><i class="bi bi-window-stack" aria-hidden="true"></i><span class="visually-hidden">Trung tâm demo</span></a>
        </nav>
    </div>
}
