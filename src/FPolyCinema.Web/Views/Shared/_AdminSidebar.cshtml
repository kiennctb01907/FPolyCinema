@* Nhóm mục sidebar (UI U4-07): Tổng quan; Bán hàng; Phim và lịch chiếu; Rạp và phòng; Kho bắp nước; Nhân sự; Báo cáo; Cấu hình.
   Mục chưa có màn hình bị khóa, có lý do trong tooltip (UI U6-02). *@
@{
    var path = Context.Request.Path.Value ?? "/";
    var isManager = Shell.IsManager;
    var isStaff = Shell.IsStaff;
    const string soon = "Chức năng này sẽ có ở bản cập nhật tới.";
    // (nhãn, icon, đường dẫn hoặc null nếu chưa có, chỉ quản lý rạp)
    var groups = new List<(string Title, List<(string Label, string Icon, string? Url, bool ManagerOnly)> Items)>
    {
        ("Tổng quan", new() { ("Bảng điều khiển", "bi-speedometer2", "/admin", true), ("Vận hành ca", "bi-broadcast", "/ops", false) }),
        ("Bán hàng", new() { ("Bán vé tại quầy", "bi-shop", "/pos/index", false), ("Máy soát vé", "bi-qr-code-scan", "/pos/gate-inspector", false), ("Bếp", "bi-fire", "/pos/fnb-kds", false), ("Hóa đơn", "bi-receipt", "/admin/bills", true), ("Doanh nghiệp", "bi-briefcase", "/admin/corporate", true) }),
        ("Phim và lịch chiếu", new() { ("Phim", "bi-film", "/admin/movies", false), ("Nhà phát hành", "bi-building", "/admin/distributors", true), ("Lịch chiếu", "bi-calendar3", "/scheduler", true) }),
        ("Rạp và phòng", new() { ("Phòng chiếu", "bi-grid-3x3-gap", "/admin/auditoriums", true), ("Bảng giá", "bi-tags", "/admin/pricing", true) }),
        ("Kho bắp nước", new() { ("Loại đồ uống", "bi-collection", "/admin/categories", false), ("Đồ uống", "bi-cup-straw", "/admin/drinks", false), ("Nguyên liệu", "bi-box-seam", "/admin/materials", true), ("Phiếu hủy hàng", "bi-trash3", "/ops/wastage", false) }),
        ("Nhân sự", new() { ("Nhân viên", "bi-people", "/admin/users", true) }),
        ("Báo cáo", new() { ("Thống kê", "bi-bar-chart", "/admin/reports", true), ("Đối soát nhà phát hành", "bi-file-earmark-spreadsheet", "/admin/reports/settlement", true) }),
        ("Cấu hình", new() { ("Cấu hình rạp", "bi-gear", null, true) }),
    };
}
@if (isStaff)
{
    @foreach (var g in groups)
    {
        // Mỗi mục theo policy của màn hình: bán hàng, bếp (PosStaff); máy soát vé (GateStaff); vận hành ca, phiếu hủy hàng (SupervisorOrManager)
        var role = Shell.User?.Role;
        bool Allowed(string? url) => url switch
        {
            "/pos/index" or "/pos/fnb-kds" => role != Roles.TicketInspector,
            "/pos/gate-inspector" => role != Roles.POSCashier,
            "/ops" or "/ops/wastage" => Shell.IsSupervisor,
            _ => true,
        };
        var items = g.Items.Where(i => (!i.ManagerOnly || isManager) && Allowed(i.Url)).ToList();
        if (items.Count == 0) { continue; }
        <div class="nav-group">
            <h2 class="nav-group-title">@g.Title</h2>
            @foreach (var i in items)
            {
                if (i.Url != null)
                {
                    var active = i.Url == "/admin" ? path.TrimEnd('/').Equals("/admin", StringComparison.OrdinalIgnoreCase)
                        : path.StartsWith(i.Url, StringComparison.OrdinalIgnoreCase) && !(i.Url == "/admin/reports" && path.StartsWith("/admin/reports/settlement", StringComparison.OrdinalIgnoreCase))
                          && !(i.Url == "/ops" && path.StartsWith("/ops/wastage", StringComparison.OrdinalIgnoreCase));
                    <a class="side-link @(active ? "active" : null)" href="@i.Url" aria-current="@(active ? "page" : null)" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-trigger="hover" title="@i.Label">
                        <i class="bi @i.Icon" aria-hidden="true"></i><span class="label">@i.Label</span>
                    </a>
                }
                else
                {
                    <span class="side-link is-disabled" aria-disabled="true" tabindex="0" data-bs-toggle="tooltip" data-bs-placement="right" title="@i.Label – @soon">
                        <i class="bi @i.Icon" aria-hidden="true"></i><span class="label">@i.Label</span><span class="soon-pill">Sắp có</span>
                    </span>
                }
            }
        </div>
    }
    <div class="nav-group">
        <h2 class="nav-group-title">Tài khoản</h2>
        <a class="side-link @(path.StartsWith("/me", StringComparison.OrdinalIgnoreCase) ? "active" : null)" href="/me" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-trigger="hover" title="Trang cá nhân">
            <i class="bi bi-person-circle" aria-hidden="true"></i><span class="label">Trang cá nhân</span>
        </a>
    </div>
}
else
{
    <div class="nav-group">
        <p class="nav-group-title">Bạn chưa đăng nhập bằng tài khoản nhân viên.</p>
        <a class="side-link" href="/Login/Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i><span class="label">Đăng nhập</span></a>
    </div>
}
